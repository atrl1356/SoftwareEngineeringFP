{
  "name": "classroom-quiz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx server/main.ts",
    "build": "vite build",
    "start": "tsx server/main.ts",
    "teacher:init": "tsx server/init.ts",
