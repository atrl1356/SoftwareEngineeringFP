    "predev": "npm run build",
    "test:sheets": "tsx tests/live-sheet.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.11",
    "fastify": "5.12.8",
    "tsx": "4.23.15",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.11",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.14"
  }
}
