QUIZ_DB=data/classroom.sqlite
HOST=127.0.0.1
PORT=3000
QUIZ_SHEETS=google  #本機測試時填fixture，讀取分頁後選單題練習
TEACHER_NAME=<teacher-account>
TEACHER_PASSWORD=<initial-password>

# 先到"https://console.cloud.google.com/apis/"新建專案
# 在專案內啟用Google Sheets API和Google Drive API
# 到Google Auth Platform，"品牌"填資訊，目標對象選外部，再到"目標對象"加入要做測試用的帳號
# "資料存取權"中新增或移除範圍，加入"https://www.googleapis.com/auth/spreadsheets"以及"https://www.googleapis.com/auth/drive.metadata.readonly"
# 最後到"用戶端"建立用戶端，選"網頁應用程式"，在授權重新導向的URI中填入"http://127.0.0.1:3000/api/google/callback"
# 完成建立後就會得到這兩個
GOOGLE_CLIENT_ID=<oauth-client-id>
GOOGLE_CLIENT_SECRET=<oauth-client-secret>

GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/google/callback

# 在本機執行'node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"'後貼上
QUIZ_TOKEN_KEY=<64-hex-digits>

# 只在執行實表驗收時填入團隊已授權的專用副本，測試用的試算表在/docs/tempsheet.xlsx
# GOOGLE_TEST_COPY_URL=https://docs.google.com/spreadsheets/d/<dedicated-test-copy-id>/edit
