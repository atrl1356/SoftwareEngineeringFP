QUIZ_DB=data/classroom.sqlite
HOST=127.0.0.1
PORT=3000

# 本機測試時填 fixture，讀取分頁後選單題練習；串接真實 Google Sheets 時填 google
QUIZ_SHEETS=google

TEACHER_NAME=your_teacher_name
TEACHER_PASSWORD=your_teacher_password

# === Google OAuth 2.0 設定步驟 ===
# 1. 先到 https://console.cloud.google.com/apis/ 新建專案
# 2. 在專案內啟用 Google Sheets API 和 Google Drive API
# 3. 到 Google Auth Platform，「品牌」填資訊、目標對象選外部，再到「目標對象」加入要做測試用的帳號
# 4. 「資料存取權」中新增或移除範圍，加入：
#    - https://www.googleapis.com/auth/spreadsheets
#    - https://www.googleapis.com/auth/drive.metadata.readonly
# 5. 最後到「用戶端」建立用戶端，選「網頁應用程式」，在已授權的重新導向 URI 填入：
#    http://127.0.0.1:3000/api/google/callback（需與下方 HOST 及 GOOGLE_REDIRECT_URI 一致）
# 6. 完成建立後填入這兩個值：
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# 請確保 HOST、GOOGLE_REDIRECT_URI 與 Google Cloud Console 設定三者統一（皆用 127.0.0.1 或皆用 localhost）
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/google/callback

# 在本機執行以下指令產生 64 字元隨機字串後貼上：
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
QUIZ_TOKEN_KEY=replace-with-64-char-hex-string

# 只在執行實表驗收時取消註解並填入團隊已授權的專用副本，測試用的試算表在 /docs/tempsheet.xlsx
# GOOGLE_TEST_COPY_URL=https://docs.google.com/spreadsheets/d/<dedicated-test-copy-id>/edit